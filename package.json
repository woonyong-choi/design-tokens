{
  "name": "@woonyong-choi/design-tokens",
  "version": "0.2.0",
  "description": "Design token source of truth in DTCG format, with generated CSS, JavaScript and JSON",
  "license": "MIT",
  "author": "choi woo-nyong",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-choi/design-tokens.git"
  },
  "homepage": "https://github.com/woonyong-choi/design-tokens#readme",
  "bugs": {
    "url": "https://github.com/woonyong-choi/design-tokens/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "css-variables",
    "dark-mode"
  ],
  "exports": {
    "./css": "./dist/tokens.css",
    "./js": "./dist/tokens.js",
    "./json": "./dist/tokens.json",
    "./package.json": "./package.json",
    "./components": "./dist/ui/index.mjs",
    "./tailwind.css": "./dist/tailwind.css",
    "./diagram": "./dist/ui/diagram.mjs",
    "./runtime/document": "./dist/ui/runtime/document.js",
    "./runtime/document-navigation": "./dist/ui/runtime/document-navigation.js",
    "./runtime/flows": "./dist/ui/runtime/flows.js",
    "./runtime/video": "./dist/ui/runtime/video.js",
    "./build/styles": "./dist/ui/build/styles.mjs",
    "./icons": "./dist/ui/build/icons.mjs",
    "./svg": "./dist/ui/svg.mjs",
    "./*": "./dist/*"
  },
  "bin": {
    "design-tokens-check": "dist/ui/build/check-tokens.mjs"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "node scripts/build.mjs --check",
    "build:diagram": "node scripts/build-diagram-package.mjs",
    "check:diagram": "node scripts/build-diagram-package.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "postcss": "8.5.29"
  },
  "devDependencies": {
    "purgecss": "7.0.2"
  },
  "overrides": {
    "purgecss": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
